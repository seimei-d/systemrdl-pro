{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SystemRDL Pro: Extension Development Host",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-systemrdl-pro",
        "${workspaceFolder}"
      ],
      "preLaunchTask": "build SystemRDL viewer and extension",
      "outFiles": [
        "${workspaceFolder}/packages/vscode-systemrdl-pro/out/**/*.js"
      ]
    }
  ]
}
